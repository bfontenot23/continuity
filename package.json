{
  "name": "continuity",
  "version": "26.8.1",
  "description": "A web app for planning interconnected stories with branching continuities",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "npm run test:selection",
    "test:selection": "esbuild tests/*.test.ts --bundle --platform=node --format=esm --outdir=.cache/selection-tests --out-extension:.js=.mjs && node --test ./.cache/selection-tests/*.test.mjs",
    "deploy": "npm run build && wrangler pages deploy dist",
    "pages:deploy": "wrangler pages deploy dist"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.2.0",
    "wrangler": "^4.61.1"
  },
  "dependencies": {
    "marked": "^17.0.1"
  }
}
